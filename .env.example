# Пример файла окружения. Скопировать в .env и заполнить.
# Секреты и настройки — вне исходного кода (ТЗ §10).

# Обязательный на проде; для локальной разработки можно оставить пустым (сгенерируется временный).
DJANGO_SECRET_KEY=

# 1 — включить режим отладки (только локально). На рабочем сервере строго 0 (ТЗ §10).
DJANGO_DEBUG=1

# Список хостов через запятую. На проде указать реальный домен.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Движок БД: sqlite (по умолчанию для локальной разработки) или postgres (прод, ТЗ §2).
DB_ENGINE=sqlite

# Параметры PostgreSQL (используются при DB_ENGINE=postgres).
DB_NAME=controlfleet
DB_USER=controlfleet
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# Корень закрытого файлового хранилища (ТЗ §9). Вне веб-корня, доступ только через проверку прав.
PRIVATE_MEDIA_ROOT=

# Прод-флаги безопасности (на HTTPS включить). Локально 0.
DJANGO_SECURE_SSL=0
